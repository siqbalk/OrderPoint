{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {TenantId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=orderpoint;Username=postgres;Password=postgres"
  },
  "Auth": {
    "Issuer": "https://orderpoint.local",
    "Audience": "orderpoint-api",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 2,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "RateLimiting": {
    "AuthenticationPermitsPerMinute": 10,
    "TenantPermitsPerMinute": 600
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Notifications": {
    "AppBaseUrl": "http://localhost:5079",
    "FromAddress": "no-reply@orderpoint.local"
  }
}
